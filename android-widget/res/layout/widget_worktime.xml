<?xml version="1.0" encoding="utf-8"?>
<!-- Compact one-row (4x1) widget. Preserve original view IDs and intents. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/widget_container"
  android:layout_width="match_parent" android:layout_height="match_parent"
  android:orientation="horizontal" android:gravity="center_vertical"
  android:paddingLeft="9dp" android:paddingRight="9dp"
  android:paddingTop="7dp" android:paddingBottom="7dp"
  android:background="@drawable/widget_background">

  <ImageView android:id="@+id/widget_logo"
    android:layout_width="30dp" android:layout_height="30dp"
    android:src="@drawable/wt_logo_badge"
    android:contentDescription="WorkTime Pro 2" />

  <LinearLayout android:layout_width="0dp" android:layout_weight="1"
    android:layout_height="wrap_content" android:orientation="vertical"
    android:layout_marginStart="7dp">
    <TextView android:id="@+id/widget_title"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="WorkTime Pro 2" android:textStyle="bold"
      android:textSize="12sp" android:textColor="#F6F9FF"
      android:singleLine="true" android:ellipsize="end" />
    <TextView android:id="@+id/widget_status"
      android:layout_width="match_parent" android:layout_height="wrap_content"
      android:text="Pronto" android:textSize="10sp"
      android:textColor="#BBD1F1" android:singleLine="true"
      android:ellipsize="end" android:layout_marginTop="2dp" />
  </LinearLayout>

  <TextView android:id="@+id/widget_primary"
    android:layout_width="80dp" android:layout_height="39dp"
    android:layout_marginStart="6dp"
    android:gravity="center" android:text="▶ Iniciar"
    android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="11sp"
    android:singleLine="true" android:background="@drawable/widget_button" />

  <TextView android:id="@+id/widget_finish"
    android:layout_width="69dp" android:layout_height="39dp"
    android:layout_marginStart="5dp"
    android:gravity="center" android:text="■ Terminar"
    android:textColor="#FFD3DA" android:textStyle="bold" android:textSize="10sp"
    android:singleLine="true" android:background="@drawable/widget_finish"
    android:visibility="gone" />
</LinearLayout>
