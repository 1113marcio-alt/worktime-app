<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="13dp" android:background="@drawable/widget_background">
    <TextView
        android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="⏱ WorkTime Pro 2"
        android:textSize="15sp" android:textStyle="bold" android:textColor="#F6F9FF"
        android:paddingBottom="6dp" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="Pronto para começar"
        android:textColor="#BCD4F3" android:textSize="13sp"
        android:paddingBottom="11dp" />
    <LinearLayout android:layout_width="match_parent"
        android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/widget_primary"
            android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="44dp" android:gravity="center"
            android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="13sp"
            android:background="@drawable/widget_button" android:text="▶ Iniciar turno" />
        <TextView android:id="@+id/widget_finish"
            android:layout_width="100dp" android:layout_marginStart="8dp"
            android:layout_height="44dp" android:gravity="center"
            android:textColor="#FFD3DA" android:textStyle="bold" android:textSize="12sp"
            android:background="@drawable/widget_finish" android:text="■ Terminar"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
